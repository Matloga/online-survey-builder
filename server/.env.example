# Server environment
PORT=4000
NODE_ENV=development

# SQL Server connection string.
# Local Express:  Server=localhost,1433;Database=SurveyBuilder;User Id=sa;Password=xxx;TrustServerCertificate=true;Encrypt=false
# Azure SQL:      Server=tcp:xyz.database.windows.net,1433;Initial Catalog=SurveyBuilder;User Id=xxx;Password=xxx;Encrypt=true;TrustServerCertificate=true
SQLSERVER_CONNECTION_STRING=Server=localhost,1433;Database=SurveyBuilder;User Id=sa;Password=CHANGE_ME;Encrypt=false;TrustServerCertificate=true

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins for the React dev server
CLIENT_ORIGIN=http://localhost:5173

# Optional bootstrap admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Admin